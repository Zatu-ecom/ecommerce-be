# VM-2 (app) — copy to ~/ecommerce-app/.env on the VM and fill values.
# DB/KV point at VM-1's PRIVATE IP (same VCN subnet). Secrets must match VM-1.

APP_ENV=dev
GIN_MODE=release
PORT=8080
LOG_LEVEL=info

# ── Postgres on VM-1 (private IP, never the public one) ──
DB_HOST=CHANGE_ME_VM1_PRIVATE_IP
DB_PORT=5432
DB_NAME=ecommerce
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_STRONG_SAME_AS_VM1
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME_MINUTES=30
DB_CONN_MAX_IDLE_TIME_MINUTES=5

# ── Auth ──
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
JWT_EXPIRY_HOURS=24

# ── Volatile cache (this VM, compose-internal) ──
CACHE_HOST=cache-volatile
CACHE_PORT=6379
CACHE_PASSWORD=CHANGE_ME_STRONG_SAME_AS_VM1
CACHE_MAXMEMORY=64mb
CACHE_ENABLED=true

# ── Durable KV on VM-1 (private IP) ──
KV_HOST=CHANGE_ME_VM1_PRIVATE_IP
KV_PORT=6381
KV_PASSWORD=CHANGE_ME_STRONG_SAME_AS_VM1

# ── App-level ──
# Public URL (no trailing slash) - used for courier webhook URLs and links.
# While TLS is pending this is the HTTP address; switch to
# https://api.dev.ecom.vitrapay.io together with the certbot rollout (spec 014 T052).
PUBLIC_API_BASE_URL=http://130.210.26.64
# 32-byte key protecting stored gateway/courier credentials. NEVER reuse dev default.
ENCRYPTION_KEY=CHANGE_ME_openssl_rand_hex_32

WORKER_POOL_SIZE=5

# ── CORS (browser origins allowed to call the API) ──
# "*" allows any origin. Tighten to the real frontend origins when they deploy.
CORS_ALLOWED_ORIGINS=*

# ── Trusted proxies (the nginx hop) ──
# CIDRs whose X-Forwarded-For / X-Real-IP are trusted. The nginx and app
# containers share the compose bridge network (private 172.16.0.0/12).
TRUSTED_PROXIES=172.16.0.0/12

# ── Messaging (RabbitMQ) - off; Noop publisher/consumer ──
MESSAGING_ENABLED=false
